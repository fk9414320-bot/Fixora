# Copy this file to ".env" (same folder as server.js) and fill it in.
# Never share your .env file or commit it to GitHub.

# Password for the admin dashboard at /admin. Pick something long.
ADMIN_KEY=change-me-to-a-long-random-phrase

# Optional: turns on real AI diagnosis. Get a key at https://console.anthropic.com
# Leave empty and the site uses its built-in keyword diagnosis instead.
ANTHROPIC_API_KEY=

# Optional
# PORT=3000
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional: email updates to customers (booking received, confirmed, on the way, arrived, completed, cancelled).
# Easiest with Gmail: turn on 2-Step Verification, then create an "App password" at
# https://myaccount.google.com/apppasswords and paste it below (no spaces). Never use your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-letter-app-password
# SMTP_FROM=Fixora <yourname@gmail.com>
# Optional: also email yourself every new booking, and put a link to your site in the emails
# ADMIN_EMAIL=yourname@gmail.com
# PUBLIC_URL=http://localhost:3000

# Going online (hosting). Your host's dashboard sets these, you do not need them on your own computer.
# NODE_ENV=production          requires ADMIN_KEY to be set
# TRUST_PROXY=1                use the visitor's real address behind your host (needed on Render, Railway, Caddy)
# DATA_DIR=/data               where bookings are stored: point it at a persistent disk
# PUBLIC_URL=https://your-site.example.com

# Supabase + Vercel (set these in Vercel > Project > Settings > Environment Variables)
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=your-service_role-key     (secret! never put it in the website files)
# With Supabase, DATA_DIR/TRUST_PROXY are not needed. Still set ADMIN_KEY and PUBLIC_URL.
